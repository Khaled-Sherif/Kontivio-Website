# ── Development defaults ──────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Vercel preview URLs (add your Vercel project URL here for local testing)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://kontivio.vercel.app

DATABASE_URL=postgresql://user:password@localhost:5432/kontivio
REDIS_URL=redis://localhost:6379/0

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

ADMIN_EMAIL=admin@kontivio.de
HR_EMAIL=hr@kontivio.de

# ── Production overrides (copy to .env and fill in) ───────────────────────────
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=replace-with-a-50-char-random-string
# DEBUG=False
#
# ALLOWED_HOSTS=api.kontivio.de
# CORS_ALLOWED_ORIGINS=https://kontivio.de,https://www.kontivio.de,https://*.vercel.app
#
# DATABASE_URL=postgres://kontivio:kontiviopass@db:5432/kontivio
#
# Cloudflare R2 (Cloudflare dashboard → R2 → your bucket → Manage API tokens)
# R2_BUCKET_NAME=kontivio-media
# R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# Zoho Mail (zoho.com/mail → Settings → Mail Accounts → SMTP)
# EMAIL_HOST=smtp.zoho.eu
# EMAIL_PORT=587
# EMAIL_HOST_USER=info@kontivio.de
# EMAIL_HOST_PASSWORD=
